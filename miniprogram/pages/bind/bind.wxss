/* pages/bind/bind.wxss */
.page-container {
  padding: 30rpx;
  padding-bottom: 60rpx;
}

.page-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.back-btn {
  font-size: 56rpx;
  color: #0052B9;
  line-height: 1;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
}

.page-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.bind-card {
  padding: 30rpx;
}

.bind-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.platform-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 24rpx;
}

.garmin-cn {
  background: linear-gradient(135deg, #00a3d9, #0088b8);
}

.garmin-com {
  background: linear-gradient(135deg, #0052B9, #003d8a);
}

.coros {
  background: linear-gradient(135deg, #ff6b00, #e05e00);
}

.platform-info {
  flex: 1;
}

.platform-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 6rpx;
}

.platform-desc {
  font-size: 24rpx;
  color: #999;
}

.bind-actions {
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.bind-user {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.btn-bind {
  background: #0052B9;
  color: #fff;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-bind:active {
  opacity: 0.85;
}

.btn-unbind {
  background: #fff1f0;
  color: #ff4d4f;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.btn-unbind:active {
  opacity: 0.85;
}

/* 绑定说明 */
.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #fff;
  border-radius: 20rpx;
  width: 80%;
  padding: 40rpx;
  z-index: 1001;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 30rpx;
}

.input-group {
  margin-bottom: 20rpx;
}

.input-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.modal-input {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.modal-btn.cancel {
  background: #f0f0f0;
  color: #666;
}

.modal-btn.confirm {
  background: #0052B9;
  color: #fff;
  font-weight: 500;
}

.modal-btn.confirm.loading {
  opacity: 0.6;
}
