/* pages/sync/sync.wxss */
.page-container {
  padding: 30rpx;
  padding-bottom: 60rpx;
}

/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.back-btn {
  font-size: 56rpx;
  color: #0052B9;
  line-height: 1;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
}

/* 账号绑定状态栏 */
.bind-status-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.bind-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
}

.bind-tag.bind-ok {
  background: #f0fff4;
  color: #389e0d;
}

.bind-tag.bind-no {
  background: #f5f5f5;
  color: #999;
}

.bind-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.dot-ok {
  background: #52c41a;
}

.dot-no {
  background: #ccc;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

/* 同步配对列表 */
.pair-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pair-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  background: #f8f9fa;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.pair-card.pair-selected {
  background: #f0f5ff;
  border-color: #0052B9;
}

/* 选中圆点 */
.pair-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.pair-selected .pair-radio {
  border-color: #0052B9;
}

.radio-dot {
  width: 0;
  height: 0;
  border-radius: 50%;
  background: transparent;
  transition: all 0.2s;
}

.radio-dot.radio-active {
  width: 18rpx;
  height: 18rpx;
  background: #0052B9;
}

/* 平台配对内容 */
.pair-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.platform-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  white-space: nowrap;
}

/* 方向切换按钮 */
.swap-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e8edf5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pair-selected .swap-btn {
  background: #0052B9;
}

.swap-arrow {
  font-size: 32rpx;
  color: #666;
  line-height: 1;
}

.pair-selected .swap-arrow {
  color: #fff;
}

/* 空状态 */
.empty-direction {
  text-align: center;
  padding: 40rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-bottom: 24rpx;
}

.btn-go-bind {
  display: inline-block;
  background: #0052B9;
  color: #fff;
  padding: 16rpx 40rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

/* 同步按钮 */
.sync-section {
  margin: 40rpx 0;
  text-align: center;
}

.btn-sync {
  background: #0052B9;
  color: #fff;
  border-radius: 16rpx;
  padding: 28rpx 0;
  font-size: 34rpx;
  font-weight: 600;
  width: 100%;
  border: none;
}

.btn-sync.disabled {
  background: #ccc;
  color: #999;
}

.btn-sync:active {
  opacity: 0.85;
}

.sync-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 同步数量选择 */
.sync-count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 28rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.sync-count-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.sync-count-picker {
  flex: 1;
  max-width: 360rpx;
}

.sync-count-value {
  font-size: 28rpx;
  color: #0052B9;
  text-align: right;
}

/* 强制重新同步 */
.force-resync-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
  cursor: pointer;
}

.force-resync-check {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
  font-size: 24rpx;
  color: #fff;
}

.force-resync-check.checked {
  background: #0052B9;
  border-color: #0052B9;
}

.force-resync-label {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 同步结果 */
.result-card {
  margin-top: 30rpx;
}

.result-summary {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.result-item {
  text-align: center;
}

.result-num {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.result-item.success .result-num {
  color: #52c41a;
}

.result-item.failed .result-num {
  color: #ff4d4f;
}

.result-label {
  font-size: 24rpx;
  color: #999;
}

/* 同步中遮罩 */
.syncing-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.syncing-content {
  text-align: center;
  color: #fff;
}

.syncing-icon {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  margin: 0 auto 30rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.syncing-text {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.syncing-sub {
  font-size: 24rpx;
  opacity: 0.7;
}

/* MFA 验证码弹窗 */
.mfa-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.mfa-modal {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
}

.mfa-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.mfa-desc {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  margin-bottom: 36rpx;
  line-height: 1.5;
}

.mfa-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  text-align: center;
  font-size: 36rpx;
  letter-spacing: 16rpx;
  margin-bottom: 36rpx;
}

.mfa-buttons {
  display: flex;
  gap: 24rpx;
}

.mfa-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
  padding: 0;
}

.mfa-btn::after {
  border: none;
}

.mfa-cancel {
  background: #f5f5f5;
  color: #666;
}

.mfa-confirm {
  background: #0052B9;
  color: #fff;
}
