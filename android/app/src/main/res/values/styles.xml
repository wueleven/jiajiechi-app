<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- 应用为纯浅色设计，固定 Light 主题不跟随系统深色模式，
         否则深色模式手机上状态栏/窗口背景会变成深灰色 -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/pageBackground</item>
        <item name="android:statusBarColor">@color/pageBackground</item>
        <item name="android:navigationBarColor">@color/pageBackground</item>
        <!-- 浅色状态栏配深色图标文字 -->
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Android 12+ 系统启动屏：背景色与 splash 图留白色一致，
             图标用 gen-splash.sh 生成的高清 splash_icon（ic_launcher_foreground 分辨率不够会发糊） -->
        <item name="windowSplashScreenBackground">#FDFDFB</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>